# Names only. Real values live in Vercel / local .env files, never in git or chat.

# Supabase (use the STAGING project outside production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for audit writes, jobs and user administration.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of this deployment, used in invitation and reset links.
APP_URL=
# local | staging | production (default local).
APP_ENV=local
# true | false (default false). Two-step verification is off unless this is true, in every environment
# (owner decision 2026-11-05; SOP 8 s4.1 asks for it, so turn it on again before others get access).
AUTH_REQUIRE_MFA=false

# Secret the scheduler sends as "Authorization: Bearer <value>" to /api/jobs/tick.
# At least 32 random characters.
CRON_SECRET=

# Push notifications (optional; without them push is simply off).
# Generate once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:you@example.com or https://your-site
VAPID_SUBJECT=

# Websites allowed to post the contact form to /api/leads/create (comma-separated, no trailing slash).
# Default: https://luminatewebdesign.com,https://www.luminatewebdesign.com
LEAD_FORM_ORIGINS=

# Key for the read-only AI assistant connector (Claude or ChatGPT custom connector) at /api/mcp.
# At least 32 random characters, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# It goes in the connector URL:  https://www.luminateos.app/api/mcp?key=<this value>
# Unset or shorter than 32 characters = the connector is off. The connector can only read, and it never
# returns contact details. To cut off access, change this value (and the connector URL) and redeploy.
MCP_API_KEY=

# Stripe webhook (POST /api/webhooks/stripe). Not set = the webhook refuses every request.
# Use a RESTRICTED key (rk_live_...) with READ access only to what the webhook reads (see docs/architecture/14).
STRIPE_SECRET_KEY=
# Signing secret of the live webhook endpoint (whsec_...). Editing the endpoint's URL in Stripe keeps the same secret.
STRIPE_WEBHOOK_SECRET=
# Optional: signing secret of a TEST-mode endpoint. Test events are ignored when APP_ENV=production.
STRIPE_WEBHOOK_SECRET_TEST=

# Speed and visual checks (Google PageSpeed Insights). Optional but recommended: without a key the
# checks share Google's tiny anonymous quota and often fail. Restrict the key to the PageSpeed Insights API.
PAGESPEED_API_KEY=

# Optional: lets the owner re-send invoices from a client's page ("Resend invoice"). A SEPARATE restricted key
# (rk_live_...) with Invoices: Write only. STRIPE_SECRET_KEY stays read-only for the webhook.
STRIPE_INVOICE_KEY=
