# Names only. Real values live in Vercel / local .env files, never in git or chat.

# Supabase (use the STAGING project outside production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for audit writes, jobs and user administration.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of this deployment, used in invitation and reset links.
APP_URL=
# local | staging | production (default local). Production always requires MFA.
APP_ENV=local
# true | false (default false). Must be true before production use (SOP 8 s4.1).
AUTH_REQUIRE_MFA=false

# Secret the scheduler sends as "Authorization: Bearer <value>" to /api/jobs/tick.
# At least 32 random characters.
CRON_SECRET=
