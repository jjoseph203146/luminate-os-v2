# Names only. Real values live in Vercel / local .env files, never in git or chat.

# Supabase (use the STAGING project outside production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for audit writes, jobs and user administration.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of this deployment, used in invitation and reset links.
APP_URL=
# local | staging | production (default local).
APP_ENV=local
# true | false (default false). Two-step verification is off unless this is true, in every environment
# (owner decision 2026-11-05; SOP 8 s4.1 asks for it, so turn it on again before others get access).
AUTH_REQUIRE_MFA=false

# Secret the scheduler sends as "Authorization: Bearer <value>" to /api/jobs/tick.
# At least 32 random characters.
CRON_SECRET=

# Push notifications (optional; without them push is simply off).
# Generate once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:you@example.com or https://your-site
VAPID_SUBJECT=

# Websites allowed to post the contact form to /api/leads/create (comma-separated, no trailing slash).
# Default: https://luminatewebdesign.com,https://www.luminatewebdesign.com
LEAD_FORM_ORIGINS=
